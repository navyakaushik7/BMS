# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
DATABASE_URL=postgresql://bms_user:bms_password@localhost:5432/booth_management
# (docker-compose sets this automatically for the containerized DB)

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Cooldown before a phone number can request another OTP (seconds)
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- Twilio (real SMS delivery) ----
# Leave these blank to run in DEV MODE: OTPs are printed to the backend
# console and returned in the API response (dev_otp field) instead of
# being texted. Fill these in with real Twilio credentials to send
# actual SMS messages to MLA phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
